# Modelo do .env.local. Copie para .env.local e preencha.
# Nunca coloque valores reais neste arquivo: ele vai para o repositório.
# Descrição de cada variável: README.md, seção 8.

# --- Banco (PostgreSQL) - obrigatório ---
PGHOST=localhost
PGPORT=5432
PGUSER=sheto
PGPASSWORD=
PGDATABASE=sheto
# Alternativa às cinco acima:
# DATABASE_URL=postgres://usuario:senha@localhost:5432/sheto

# --- Autenticação (NextAuth) - obrigatório ---
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# --- E-mail (SMTP) - obrigatório para enviar e-mails ---
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# SMTP_FROM="SHETO" <no-reply@seduc.to.gov.br>

# --- Endereços ---
# APP_BASE_URL=https://sheto.seduc.to.gov.br
# SUPORTE_EMAIL=sheto@seduc.to.gov.br

# --- Chat de suporte (Gemini) - opcional ---
# Sem nenhuma chave, o botão Suporte vai direto para a abertura de chamado.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
# GEMINI_MODELOS=

# --- Ajustes de operação - opcionais (os valores abaixo são os padrões) ---
# PG_POOL_MAX=10
# SHETO_WORKERS=
# SHETO_TEMPO_MAX_TURNO_S=7200
# SHETO_WORKER_TIMEOUT_MS=600000
# SHETO_LOG_PATH=./log.txt
# SHETO_LOG_MAX_MB=20
